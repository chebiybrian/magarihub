# Copy this file to .env before running the server
# The database now lives on Neon (free hosted PostgreSQL) — local dev and the live
# server use the same one. Paste your connection string from https://neon.tech:
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/neondb?sslmode=require"

# Change this to any long random string. It signs login tokens (JWTs).
JWT_SECRET="change-me-to-a-long-random-secret"

PORT=4000

# Comma-separated emails allowed to approve badges manually and post ads.
ADMIN_EMAILS="chebiybrian@gmail.com"

# ---------- MEDIA STORAGE ----------
# Leave blank locally (files save to backend/uploads/). REQUIRED on Render:
# paste the "API environment variable" from your Cloudinary dashboard, it looks like
# cloudinary://123456789:abcdefg@yourcloudname
CLOUDINARY_URL=""

# ---------- PAYMENTS ----------
# Leave these blank to run in DEMO/SIMULATE mode (badge is auto-granted for testing,
# no real money moves). Fill them in to take real payments.

# M-Pesa Daraja (https://developer.safaricom.co.ke) — Lipa na M-Pesa Online / STK Push
MPESA_ENV="sandbox"            # "sandbox" or "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""             # your Paybill or Till number
MPESA_PASSKEY=""
# Must be a PUBLIC https URL. In dev, run: npx ngrok http 4000  and use the https URL below.
MPESA_CALLBACK_URL=""          # e.g. https://abcd1234.ngrok.io/api/payments/mpesa/callback

# Card payments via Flutterwave (https://flutterwave.com) — supports Kenyan cards + M-Pesa
FLUTTERWAVE_SECRET_KEY=""
PUBLIC_WEB_URL="http://localhost:5173"

# ---------- DRIVER LICENCE AI VETTING ----------
# Reads uploaded driving-licence scans and extracts the name/number/classes.
# Leave blank for DEMO mode (vetting is simulated). Add a key for real AI reading.
ANTHROPIC_API_KEY=""
VET_MODEL="claude-3-5-sonnet-20241022"

# ---------- EXTERNAL PRICE REFERENCE (advanced / optional) ----------
# The market price estimator can blend in sample prices from external car sites.
# OFF by default. Most sites' terms prohibit scraping and can block your server —
# only enable a source you're permitted to use (a partnership, licensed data, or
# your own scraper you accept responsibility for). Store only aggregates, refresh
# on a schedule, never on every request. See backend/src/priceSources.js.
ENABLE_EXTERNAL_PRICE_SOURCES=""   # set to 1 to allow external sources at all
PRICE_SOURCE_JIJI=""               # set to 1 to enable the Jiji adapter (verify ToS first)
